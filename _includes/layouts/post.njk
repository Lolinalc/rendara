{% extends "layouts/base.njk" %}

{% block schema %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "BlogPosting",
            "headline": {{ title | json | safe }},
            "description": {{ description | json | safe }},
            "datePublished": "{{ page.date | isoDate }}",
            "dateModified": "{{ (updated or page.date) | isoDate }}",
            "inLanguage": "es-MX",
            "mainEntityOfPage": "https://rendaramx.com{{ page.url }}",
            "image": "https://rendaramx.com/images/og-rendara.jpg",
            "author": { "@type": "Organization", "name": "Rendara", "url": "https://rendaramx.com/" },
            "publisher": {
              "@type": "Organization",
              "name": "Rendara",
              "logo": { "@type": "ImageObject", "url": "https://rendaramx.com/images/RendaraTransparenteHorizontal-recorte.png" }
            }
          },
          {
            "@type": "BreadcrumbList",
            "itemListElement": [
              { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://rendaramx.com/" },
              { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://rendaramx.com/blog/" },
              { "@type": "ListItem", "position": 3, "name": {{ title | json | safe }} }
            ]
          }
        ]
      }
    </script>
{% endblock %}

{% block content %}
      <article class="post">
        <header class="post__header">
          <div class="container post__container">
            <nav class="post__breadcrumb" aria-label="Ruta">
              <a href="/">Inicio</a> <span aria-hidden="true">/</span>
              <a href="/blog/">Blog</a>
            </nav>
            <div class="tag">{{ categoria or "Guía para propietarios" }}</div>
            <h1 class="post__title">{{ title }}</h1>
            <p class="post__lead">{{ description }}</p>
            <p class="post__meta">
              Por el equipo de Rendara ·
              <time datetime="{{ page.date | isoDate }}">{{ page.date | fechaLarga }}</time>
              · {{ content | minutosLectura }} min de lectura
            </p>
          </div>
        </header>

        <div class="container post__container">
          <div class="post__body">
{{ content | safe }}
          </div>

          <aside class="post__cta" aria-label="Evaluar mi propiedad">
            <div class="tag">Para propietarios</div>
            <h2 class="post__cta-title">¿Tu propiedad ya está rentada?</h2>
            <p>
              Administramos casas, departamentos y edificios en renta de largo plazo
              en Mérida. Cobramos solo sobre la renta efectivamente cobrada.
            </p>
            <a href="/#contacto" class="btn-primary">
              Evaluar mi propiedad <span class="arrow-icon">↗</span>
            </a>
            <p class="text-fine">Rendara no renta ni vende inmuebles.</p>
          </aside>

          {%- if collections.posts.length > 1 %}
          <section class="post__related" aria-labelledby="relacionados">
            <h2 id="relacionados" class="post__related-title">Sigue leyendo</h2>
            <ul class="post-list post-list--compact">
              {%- for p in collections.posts %}
                {%- if p.url != page.url and loop.index0 < 4 %}
              <li class="post-card">
                <a href="{{ p.url }}">
                  <span class="post-card__title">{{ p.data.title }}</span>
                  <span class="post-card__desc">{{ p.data.description }}</span>
                </a>
              </li>
                {%- endif %}
              {%- endfor %}
            </ul>
          </section>
          {%- endif %}
        </div>
      </article>
{% endblock %}
