{% extends "layouts/base.njk" %}

{% block schema %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "BlogPosting",
            "headline": {{ title | json | safe }},
            "description": {{ description | json | safe }},
            "datePublished": "{{ page.date | isoDate }}",
            "dateModified": "{{ (updated or page.date) | isoDate }}",
            "inLanguage": "{{ i18n[lang].htmlLang }}",
            "mainEntityOfPage": "https://rendaramx.com{{ page.url }}",
            "image": "https://rendaramx.com/images/og-rendara.jpg",
            "author": { "@type": "Organization", "name": "Rendara", "url": "https://rendaramx.com/" },
            "publisher": {
              "@type": "Organization",
              "name": "Rendara",
              "logo": { "@type": "ImageObject", "url": "https://rendaramx.com/images/RendaraTransparenteHorizontal-recorte.png" }
            }
          },
          {
            "@type": "BreadcrumbList",
            "itemListElement": [
              { "@type": "ListItem", "position": 1, "name": "{{ i18n[lang].breadcrumbHome }}", "item": "https://rendaramx.com{{ i18n[lang].home }}" },
              { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://rendaramx.com{{ i18n[lang].blog }}" },
              { "@type": "ListItem", "position": 3, "name": {{ title | json | safe }} }
            ]
          }
        ]
      }
    </script>
{% endblock %}

{% block content %}
{%- set t = i18n[lang or "es"] %}
{%- set posts = collections.posts if lang == "es" else collections.postsEn %}
      <article class="post">
        <header class="post__header">
          <div class="container post__container">
            <nav class="post__breadcrumb" aria-label="{{ t.breadcrumbAria }}">
              <a href="{{ t.home }}">{{ t.breadcrumbHome }}</a> <span aria-hidden="true">/</span>
              <a href="{{ t.blog }}">Blog</a>
            </nav>
            <div class="tag">{{ categoria or t.defaultCategory }}</div>
            <h1 class="post__title">{{ title }}</h1>
            <p class="post__lead">{{ description }}</p>
            <p class="post__meta">
              {{ t.by }} ·
              <time datetime="{{ page.date | isoDate }}">{{ page.date | fechaLarga(t.dateLocale) }}</time>
              · {{ content | minutosLectura }} {{ t.readTime }}
            </p>
          </div>
        </header>

        <div class="container post__container">
          <div class="post__body">
{{ content | safe }}
          </div>

          <aside class="post__cta" aria-label="{{ t.cta }}">
            <div class="tag">{{ t.ctaTag }}</div>
            <h2 class="post__cta-title">{{ t.ctaTitle }}</h2>
            <p>{{ t.ctaText }}</p>
            <a href="{{ t.home }}#contacto" class="btn-primary">
              {{ t.cta }} <span class="arrow-icon">↗</span>
            </a>
            <p class="text-fine">{{ t.ctaFine }}</p>
          </aside>

          {%- if posts.length > 1 %}
          <section class="post__related" aria-labelledby="relacionados">
            <h2 id="relacionados" class="post__related-title">{{ t.related }}</h2>
            <ul class="post-list post-list--compact">
              {%- for p in posts %}
                {%- if p.url != page.url and loop.index0 < 4 %}
              <li class="post-card">
                <a href="{{ p.url }}">
                  <span class="post-card__title">{{ p.data.title }}</span>
                  <span class="post-card__desc">{{ p.data.description }}</span>
                </a>
              </li>
                {%- endif %}
              {%- endfor %}
            </ul>
          </section>
          {%- endif %}
        </div>
      </article>
{% endblock %}
