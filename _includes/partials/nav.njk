{%- set t = i18n[lang or "es"] -%}
{%- set other = i18n[t.otherLang] -%}
{%- set altHref = altUrl or other.blog -%}
    <!-- NAV -->
    <nav class="nav" role="navigation" aria-label="{{ t.navAria }}">
      <div class="nav__inner">
        <a href="{{ t.home }}" class="nav__logo" aria-label="{{ t.homeAria }}">
          <img
            class="nav__logo-img nav__logo-img--light"
            src="/images/RendaraHorizontalBlanco-recorte.png"
            alt="{{ t.logoAlt }}"
            width="136"
            height="40"
          />
          <img
            class="nav__logo-img nav__logo-img--color"
            src="/images/RendaraTransparenteHorizontal-recorte.png"
            alt=""
            aria-hidden="true"
            width="136"
            height="40"
          />
        </a>
        <ul class="nav__links" role="list">
          <li><a href="{{ t.home }}#servicios">{{ t.nav.servicios }}</a></li>
          <li><a href="{{ t.home }}#administracion">{{ t.nav.administracion }}</a></li>
          <li><a href="{{ t.home }}#mantenimiento">{{ t.nav.mantenimiento }}</a></li>
          <li><a href="{{ t.home }}#proceso">{{ t.nav.proceso }}</a></li>
          <li><a href="{{ t.home }}#faq">{{ t.nav.faq }}</a></li>
          <li><a href="{{ t.blog }}">{{ t.nav.blog }}</a></li>
          <li><a href="{{ altHref }}" class="nav__lang" hreflang="{{ t.otherLang }}" lang="{{ t.otherLang }}" aria-label="{{ t.otherAria }}">{{ t.otherLabel }}</a></li>
        </ul>
        <div class="nav__cta">
          <a href="{{ t.home }}#contacto" class="btn-primary"
            >{{ t.cta }} <span class="arrow-icon">↗</span></a
          >
          <button
            class="nav__hamburger"
            id="hamburger"
            aria-label="{{ t.menuOpen }}"
            aria-expanded="false"
          >
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </nav>

    <div
      class="nav__mobile"
      id="mobile-menu"
      role="dialog"
      aria-label="{{ t.menuMobile }}"
    >
      <ul class="nav__mobile-list" role="list">
        <li><a href="{{ t.home }}#servicios" class="mobile-link">{{ t.nav.servicios }}</a></li>
        <li><a href="{{ t.home }}#administracion" class="mobile-link">{{ t.nav.administracionLong }}</a></li>
        <li><a href="{{ t.home }}#mantenimiento" class="mobile-link">{{ t.nav.mantenimientoLong }}</a></li>
        <li><a href="{{ t.home }}#proceso" class="mobile-link">{{ t.nav.proceso }}</a></li>
        <li><a href="{{ t.home }}#faq" class="mobile-link">{{ t.nav.faqLong or t.nav.faq }}</a></li>
        <li><a href="{{ t.blog }}" class="mobile-link">{{ t.nav.blog }}</a></li>
      </ul>
      <div class="nav__mobile-footer">
        <a href="{{ t.home }}#contacto" class="btn-primary nav__mobile-cta mobile-link">{{ t.cta }} <span class="arrow-icon">↗</span></a>
        <div class="nav__mobile-meta">
          <a href="https://wa.me/529992393493" class="nav__mobile-contact" target="_blank" rel="noopener noreferrer">{{ t.nav.contacto }}: +52 999 239 3493</a>
          <div class="lang-switch" role="group" aria-label="{{ t.langLabel }}">
          {%- if lang == "en" %}
            <a href="{{ altHref }}" class="lang-switch__item" hreflang="es" lang="es" aria-label="{{ t.otherAria }}">ES</a>
            <span class="lang-switch__item is-active" aria-current="true">EN</span>
          {%- else %}
            <span class="lang-switch__item is-active" aria-current="true">ES</span>
            <a href="{{ altHref }}" class="lang-switch__item" hreflang="en" lang="en" aria-label="{{ t.otherAria }}">EN</a>
          {%- endif %}
          </div>
        </div>
      </div>
    </div>
