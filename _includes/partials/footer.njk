{%- set t = i18n[lang or "es"] -%}
{%- set other = i18n[t.otherLang] -%}
{%- set altHref = altUrl or other.blog -%}
    <!-- FOOTER -->
    <footer role="contentinfo">
      <div class="container">
        <div class="footer__inner">
          <a href="{{ t.home }}" class="footer__logo" aria-label="{{ t.homeAria }}">
            <img src="/images/RendaraBlanco-recorte.png" alt="Rendara" loading="lazy" />
          </a>
          <nav class="footer__nav" aria-label="{{ t.footerAria }}">
            <a href="{{ t.home }}#servicios">{{ t.nav.servicios }}</a>
            <a href="{{ t.home }}#administracion">{{ t.nav.administracion }}</a>
            <a href="{{ t.home }}#mantenimiento">{{ t.nav.mantenimiento }}</a>
            <a href="{{ t.home }}#proceso">{{ t.nav.proceso }}</a>
            <a href="{{ t.home }}#faq">{{ t.nav.faq }}</a>
            <a href="{{ t.blog }}">{{ t.nav.blog }}</a>
            <a href="{{ t.home }}#contacto">{{ t.nav.contacto }}</a>
            <a href="{{ altHref }}" hreflang="{{ t.otherLang }}" lang="{{ t.otherLang }}">{{ t.otherLabelLong }}</a>
          </nav>
          <a href="mailto:rendaramx@gmail.com" class="btn-outline">rendaramx@gmail.com</a>
        </div>
        <div class="footer__bottom">
          <p class="footer__copy">{{ t.copy }}</p>
          <p class="footer__location">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            {{ t.location }}
          </p>
        </div>
      </div>
    </footer>
